rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isMutuallyLinkedPartnerOf(userId) {
      return isSignedIn() &&
             request.auth.uid != userId &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             getUserData(request.auth.uid).get('isPartnerLinked', false) == true &&
             getUserData(request.auth.uid).get('partnerId', '') == userId &&
             getUserData(userId).get('isPartnerLinked', false) == true &&
             getUserData(userId).get('partnerId', '') == request.auth.uid &&
             getUserData(userId).get('isSharingPaused', false) == false;
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email']) &&
             isValidId(data.id) &&
             isBoundedString(data.name, 1, 120) &&
             isBoundedString(data.email, 3, 160) &&
             (!('partnerId' in data) || data.partnerId == null || isValidId(data.partnerId)) &&
             (!('partnerName' in data) || data.partnerName == null || isBoundedString(data.partnerName, 0, 120)) &&
             (!('cycleLength' in data) || (data.cycleLength is number && data.cycleLength >= 15 && data.cycleLength <= 90)) &&
             (!('periodLength' in data) || (data.periodLength is number && data.periodLength >= 1 && data.periodLength <= 21)) &&
             (!('notifications' in data) || (data.notifications is list && data.notifications.size() <= 150)) &&
             (!('periods' in data) || (data.periods is list && data.periods.size() <= 200)) &&
             (!('periodDates' in data) || (data.periodDates is list && data.periodDates.size() <= 1000)) &&
             (!('symptoms' in data) || (data.symptoms is list && data.symptoms.size() <= 1000)) &&
             (!('moodLogs' in data) || (data.moodLogs is list && data.moodLogs.size() <= 1000)) &&
             (!('diaryEntries' in data) || (data.diaryEntries is list && data.diaryEntries.size() <= 500)) &&
             (!('diaryPinHash' in data) || isBoundedString(data.diaryPinHash, 32, 128)) &&
             (!('diaryPinSalt' in data) || isBoundedString(data.diaryPinSalt, 16, 128)) &&
             (!('isAdmin' in data));
    }

    function isValidPartnerSharedSummary(data, userId) {
      return data.keys().hasAll(['ownerId', 'ownerName', 'isPartnerLinked', 'isSharingPaused', 'updatedAt', 'sharingSettings']) &&
             data.ownerId == userId &&
             isBoundedString(data.ownerName, 1, 120) &&
             data.isPartnerLinked is bool &&
             data.isSharingPaused is bool &&
             isBoundedString(data.updatedAt, 10, 64) &&
             data.sharingSettings is map &&
             !('diaryEntries' in data) &&
             !('diaryPin' in data) &&
             !('diaryPinHash' in data) &&
             !('diaryPinSalt' in data) &&
             !('securitySettings' in data) &&
             !('privacyPreferences' in data) &&
             !('backupMetadata' in data) &&
             !('email' in data) &&
             !('billingHistory' in data);
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['code', 'senderId', 'senderName', 'createdAt']) &&
             data.keys().hasOnly(['code', 'senderId', 'senderName', 'senderEmail', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             isBoundedString(data.code, 6, 12) &&
             data.code.matches('^[A-Z0-9]+$') &&
             isBoundedString(data.senderName, 1, 120) &&
             (!('senderEmail' in data) || isBoundedString(data.senderEmail, 0, 160)) &&
             isBoundedString(data.createdAt, 10, 64);
    }

    function isValidGift(data) {
      return data.keys().hasAll(['id', 'type', 'senderId', 'senderName', 'timestamp']) &&
             data.keys().hasOnly(['id', 'type', 'senderId', 'senderName', 'timestamp']) &&
             isValidId(data.id) &&
             data.senderId == request.auth.uid &&
             data.type in ['hug', 'tea', 'flower', 'chocolate', 'sparkle', 'love_note'] &&
             isBoundedString(data.senderName, 1, 120) &&
             isBoundedString(data.timestamp, 10, 64);
    }

    function isValidPartnerRequest(data) {
      return data.keys().hasAll(['id', 'user_id', 'partner_id', 'partnerName', 'requested_permissions', 'status', 'created_at']) &&
             data.keys().hasOnly(['id', 'request_id', 'user_id', 'userId', 'partner_id', 'partnerId', 'partnerName', 'partnerEmail', 'requested_permissions', 'status', 'created_at', 'createdAt']) &&
             isValidId(data.id) &&
             isValidId(data.user_id) &&
             isValidId(data.partner_id) &&
             data.status in ['pending', 'approved', 'declined'] &&
             isBoundedString(data.partnerName, 1, 120) &&
             (!('partnerEmail' in data) || isBoundedString(data.partnerEmail, 0, 160)) &&
             isBoundedString(data.created_at, 10, 64) &&
             data.requested_permissions is list &&
             data.requested_permissions.size() <= 20;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientId', 'senderId', 'title', 'body', 'timestamp']) &&
             data.keys().hasOnly(['id', 'recipientId', 'targetUserId', 'senderId', 'type', 'category', 'title', 'body', 'emoji', 'read', 'isRead', 'isPartnerRequest', 'timestamp']) &&
             isValidId(data.id) &&
             isValidId(data.recipientId) &&
             isValidId(data.senderId) &&
             isBoundedString(data.title, 1, 160) &&
             isBoundedString(data.body, 1, 600) &&
             isBoundedString(data.timestamp, 10, 64) &&
             (!('emoji' in data) || isBoundedString(data.emoji, 0, 16));
    }

    function isValidTelemetry(data) {
      return data.keys().hasAll(['userId', 'timestamp']) &&
             data.userId == request.auth.uid &&
             isBoundedString(data.timestamp, 10, 64) &&
             (!('eventName' in data) || isBoundedString(data.eventName, 1, 100)) &&
             (!('category' in data) || isBoundedString(data.category, 1, 64)) &&
             (!('errorMessage' in data) || isBoundedString(data.errorMessage, 0, 350)) &&
             (!('errorStack' in data) || isBoundedString(data.errorStack, 0, 1200));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Strictly owner-only read; partners read only consented projections under /partner_shared/summary
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == request.auth.uid &&
                       incoming().get('isPremium', false) == false;
      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       (incoming().email == existing().email || incoming().email == request.auth.token.email) &&
                       (
                         incoming().get('isPremium', false) == existing().get('isPremium', false) ||
                         incoming().get('isPremium', false) == false ||
                         (
                           incoming().get('isPremium', false) == true &&
                           incoming().get('subscriptionStatus', 'none') == 'active' &&
                           incoming().get('subscriptionPlan', 'free') in ['monthly', '6month', 'yearly'] &&
                           'subscriptionEnd' in incoming() &&
                           isBoundedString(incoming().subscriptionEnd, 10, 64)
                         )
                       );
      allow delete: if isValidId(userId) && isOwner(userId);

      // Projected consented summary view accessible strictly to mutually linked non-paused partner
      match /partner_shared/{docId} {
        allow get: if isValidId(userId) &&
                      docId == 'summary' &&
                      (isOwner(userId) || isMutuallyLinkedPartnerOf(userId));
        allow list: if false;
        allow create, update: if isValidId(userId) &&
                                 docId == 'summary' &&
                                 isOwner(userId) &&
                                 isValidPartnerSharedSummary(incoming(), userId);
        allow delete: if isValidId(userId) && docId == 'summary' && isOwner(userId);
      }

      match /gifts/{giftId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(giftId) && isSignedIn() &&
                         isValidGift(incoming()) &&
                         exists(/databases/$(database)/documents/users/$(userId)) &&
                         (isMutuallyLinkedPartnerOf(userId) || isOwner(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(giftId) && isOwner(userId);
      }
    }

    match /invites/{code} {
      allow get: if isValidId(code) && isSignedIn();
      allow list: if false;
      allow create: if isValidId(code) && isSignedIn() && isValidInvite(incoming()) && incoming().code == code;
      allow update: if false;
      allow delete: if isValidId(code) && isSignedIn() && (
        existing().senderId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).get('partnerId', '') == existing().senderId)
      );
    }

    match /partner_requests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() &&
                    (request.auth.uid == existing().user_id || request.auth.uid == existing().partner_id);
      allow list: if isSignedIn() &&
                     (request.auth.uid == existing().user_id || request.auth.uid == existing().partner_id);
      allow create: if isValidId(requestId) && isSignedIn() &&
                       isValidPartnerRequest(incoming()) &&
                       request.auth.uid == incoming().partner_id &&
                       exists(/databases/$(database)/documents/users/$(incoming().user_id));
      allow update: if isValidId(requestId) && isSignedIn() && isValidPartnerRequest(incoming()) &&
                       incoming().user_id == existing().user_id &&
                       incoming().partner_id == existing().partner_id &&
                       incoming().created_at == existing().created_at && (
        (
          request.auth.uid == existing().user_id &&
          existing().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
          incoming().status in ['approved', 'declined']
        ) ||
        (
          request.auth.uid == existing().partner_id &&
          existing().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['partnerName', 'partnerEmail', 'requested_permissions'])
        )
      );
      allow delete: if isValidId(requestId) && isSignedIn() &&
                       (request.auth.uid == existing().user_id || request.auth.uid == existing().partner_id);
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() &&
                    (request.auth.uid == existing().recipientId || request.auth.uid == existing().senderId);
      allow list: if isSignedIn() &&
                     (request.auth.uid == existing().recipientId || request.auth.uid == existing().senderId);
      allow create: if isValidId(notificationId) && isSignedIn() &&
                       isValidNotification(incoming()) &&
                       incoming().senderId == request.auth.uid &&
                       exists(/databases/$(database)/documents/users/$(incoming().recipientId));
      allow update: if isValidId(notificationId) && isSignedIn() &&
                       isValidNotification(incoming()) &&
                       request.auth.uid == existing().recipientId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read', 'isRead']);
      allow delete: if isValidId(notificationId) && isSignedIn() &&
                       (request.auth.uid == existing().recipientId || request.auth.uid == existing().senderId);
    }

    match /global_config/{configId} {
      allow get: if isValidId(configId) && isSignedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /analytics_events/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(eventId) && isSignedIn() && isValidTelemetry(incoming());
      allow update, delete: if false;
    }

    match /crash_reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(reportId) && isSignedIn() && isValidTelemetry(incoming());
      allow update, delete: if false;
    }
  }
}
